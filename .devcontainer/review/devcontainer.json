{
  "name": "Tunarr: PR Review",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "remoteUser": "node",
  "postCreateCommand": "bash .devcontainer/post-create.sh review",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "Tunarr server" },
    "5173": { "label": "Web dev server" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.vscode-pull-request-github",
        "oxc.oxc-vscode",
        "esbenp.prettier-vscode",
        "vitest.explorer"
      ]
    }
  }
}

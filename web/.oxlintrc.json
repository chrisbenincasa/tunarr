{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "extends": ["../.oxlintrc.json"],
  "plugins": ["typescript", "react"],
  "env": {
    "browser": true,
    "es2020": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": {
          "attributes": false
        }
      }
    ],
    "typescript/only-throw-error": [
      "error",
      {
        "allow": ["Redirect", "NotFoundError"],
        "allowThrowingAny": false,
        "allowThrowingUnknown": false
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "material-react-table",
            "message": "Use DataTable from components/ui/table. See plans/mrt-replacement.md."
          },
          {
            "name": "@mui/material",
            "importNames": [
              "Table",
              "TableBody",
              "TableCell",
              "TableContainer",
              "TableFooter",
              "TableHead",
              "TablePagination",
              "TableRow",
              "TableSortLabel"
            ],
            "message": "Use DataTable from components/ui/table. See plans/mrt-replacement.md."
          }
        ],
        "patterns": [
          {
            "group": ["@mui/material/Table*"],
            "message": "Use DataTable from components/ui/table. See plans/mrt-replacement.md."
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "**/.tsup/*",
    "**/dist/*",
    "**/build/*",
    "**/scripts/*",
    "**/*.config.ts",
    "**/*.ignore.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/generated/*"
  ],
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "src/components/MediaSourceLibraryTable.tsx",
        "src/components/channel_config/ChannelSubtitlePreferencesTable.tsx",
        "src/components/settings/ConnectMediaSources.tsx",
        "src/components/settings/ffmpeg/TranscodeConfigsTable.tsx",
        "src/components/slot_scheduler/RandomSlotTable.tsx",
        "src/components/slot_scheduler/TimeSlotTable.tsx",
        "src/components/smart_collections/SmartCollectionsTable.tsx",
        "src/hooks/useTableSettings.ts",
        "src/pages/channels/ChannelsPage.tsx",
        "src/pages/library/CustomShowsPage.tsx",
        "src/pages/settings/MediaSourceSettingsPage.tsx",
        "src/pages/settings/TaskSettingsPage.tsx",
        "src/pages/system/StatusPage.tsx",
        "src/pages/system/SystemLogsPage.tsx",
        "src/pages/system/TroubleshootPage.tsx"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}

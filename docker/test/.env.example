# Settings for `pnpm docker-test`. Copy to docker/test/.env and edit.
# docker/test/.env is ignored by git.
#
# Every path here is a path on the Docker host. When TUNARR_TEST_DOCKER_CONTEXT
# points at a remote server, that means the server, not this machine.

# Docker context to build and run on. Leave empty to use the local daemon.
# Create a remote one with:
#   docker context create my-server --docker "host=ssh://user@my-server"
TUNARR_TEST_DOCKER_CONTEXT=

# Hardware pipeline: none, or the name of a file in docker/test/pipelines
# (vaapi, qsv, nvidia).
TUNARR_TEST_PIPELINE=none

# Required. Mounted at /config/tunarr. Use a directory set aside for testing,
# never the data directory of a live install: a test build may run migrations.
TUNARR_TEST_DATA_DIR=/srv/tunarr-test

# Host port for the web UI and API.
TUNARR_TEST_PORT=8001

TUNARR_TEST_TZ=UTC

# Log level, such as info or debug. Leave empty to use the level saved in
# Tunarr's settings.
TUNARR_TEST_LOG_LEVEL=

# Architecture of the Docker host: linux-x64 or linux-arm64.
TUNARR_TEST_EXEC_TARGET=linux-x64

# Device passed to the container by the vaapi and qsv pipelines.
TUNARR_TEST_RENDER_DEVICE=/dev/dri
